@model Summary.Rubika.Workflows.Task.Bot.Message.Send.SendBotMessageInRubikaViewModel

<div class="row">
  <div class="col-md-3">
    <div class="form-group">
      <label asp-for="Token">شناسه </label>
      <input type="text" asp-for="Token" class="form-control" />
    </div>
  </div>
  <div class="col-md-3">
    <div class="form-group">
      <label asp-for="Originator">شماره ارسال کننده</label>
      <input type="text" asp-for="Originator" class="form-control" />
    </div>
  </div>
  <div class="col-md-3">
    <div class="form-group>
      <label asp-for="Recipients">شماره دریافت کننده(ها)</label>
      <input type="text" asp-for="Recipients" class="form-control" />
    </div>
  </div>
</div>